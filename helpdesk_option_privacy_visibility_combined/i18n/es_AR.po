msgid "All internal users (company)"
msgstr "Todos los usuarios internos (empresa) "

#. module: new_option_privacy_visibility
#: model:ir.model.fields.selection,name:new_option_privacy_visibility.selection__helpdesk_team__privacy_visibility__combined
msgid "Combined Internal and Portal Access"
msgstr "Acceso combinado interno y al portal"

#. module: new_option_privacy_visibility
#. odoo-python
#: code:addons/new_option_privacy_visibility/models/helpdesk_team.py:0
#, python-format
msgid "Customers will be added to the followers of their tickets."
msgstr "Los clientes se agregarán a los seguidores de sus tickets."

#. module: new_option_privacy_visibility
#. odoo-python
#: code:addons/new_option_privacy_visibility/models/helpdesk_team.py:0
#, python-format
msgid "Grant employees access to your helpdesk team or tickets by adding them as followers. Employees automatically get access to the tickets they are assigned to."
msgstr ""
"Conceda a los empleados acceso a su equipo de soporte técnico o a sus tickets agregándolos como seguidores. Los empleados obtienen acceso automáticamente a los tickets a los que están asignados."

#. module: new_option_privacy_visibility
#. odoo-python
#: code:addons/new_option_privacy_visibility/models/helpdesk_team.py:0
#, python-format
msgid "Grant portal users access to your helpdesk team or tickets by adding them as followers. Customers automatically get access to their tickets in their portal."
msgstr "Otorgue a los usuarios del portal acceso a su equipo de soporte técnico o a sus tickets agregándolos como seguidores. Los clientes obtienen acceso automático a sus tickets en su portal."

#. module: new_option_privacy_visibility
#. odoo-python
#: code:addons/new_option_privacy_visibility/models/helpdesk_team.py:0
#, python-format
msgid ""
"Grant portal users access to your helpdesk team or tickets by adding them as followers. Customers automatically get access to their tickets in their portal.\n"
"\n"
"Grant employees access to your helpdesk team or tickets by adding them as followers. Employees automatically get access to the tickets they are assigned to."
msgstr ""
"Otorgue a los usuarios del portal acceso a su equipo de soporte técnico o a sus tickets agregándolos como seguidores. Los clientes obtienen acceso automático a sus tickets en su portal.\n"
"\n"
"Otorgue a los empleados acceso a su equipo de soporte técnico o a sus tickets agregándolos como seguidores. Los empleados obtienen acceso automático a los tickets a los que están asignados."

#. module: new_option_privacy_visibility
